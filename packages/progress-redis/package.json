{
  "name": "@cnstra/progress-redis",
  "version": "0.1.0",
  "description": "Redis-backed progress store (ICNSProgressRepository) for CNStra durable resume — broker-agnostic, use with pg-boss, BullMQ, or anything",
  "keywords": ["cnstra", "redis", "progress", "durable", "resume", "checkpoint"],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" } },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@cnstra/persist": "^0.1.0",
    "@cnstra/persist-dto": "^0.1.0",
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": { "ioredis": { "optional": true } },
  "devDependencies": {
    "@cnstra/persist": "^0.1.0",
    "@cnstra/persist-dto": "^0.1.0",
    "@types/jest": "29.5.12",
    "ioredis": "^5.4.0",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": { "access": "public" }
}
