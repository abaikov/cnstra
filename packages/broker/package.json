{
  "name": "@cnstra/broker",
  "version": "0.2.0",
  "description": "Broker-agnostic core for CNStra queue integrations: run one job as one stimulation, with observability + resumable execution. Shared by @cnstra/bullmq and @cnstra/pg-boss.",
  "keywords": [
    "cnstra",
    "broker",
    "queue",
    "worker",
    "resumable",
    "resume"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate",
    "build": "tsup",
    "test": "jest --passWithNoTests",
    "test:types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cnstra/types": "^0.2.0"
  },
  "peerDependencies": {
    "@cnstra/core": "^3.0.0",
    "@cnstra/persist": "^0.2.0",
    "@cnstra/persist-dto": "^0.2.0"
  },
  "devDependencies": {
    "@cnstra/core": "^3.0.0",
    "@cnstra/persist": "^0.2.0",
    "@cnstra/persist-dto": "^0.2.0",
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
