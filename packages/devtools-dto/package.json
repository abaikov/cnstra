{
  "name": "@cnstra/devtools-dto",
  "version": "3.2.1",
  "description": "Standardized DevTools data transfer objects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/devtools-dto"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate",
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cnstra/persist-dto": "^0.2.0",
    "zod": "^4.4.3"
  }
}
