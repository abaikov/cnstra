{
  "name": "@cnstra/jobs-adapter",
  "version": "0.1.0",
  "description": "Runs @cnstra/jobs job types as CNStra stimulations: a job type is an entry collateral, a job is a resumable stimulation, enqueueing from a neuron links the runs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/jobs-adapter"
  },
  "keywords": [
    "cnstra",
    "jobs",
    "queue",
    "stimulation",
    "resume"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate",
    "build": "tsup",
    "test": "jest",
    "test:types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cnstra/broker": "^0.2.2",
    "@cnstra/types": "^0.2.1"
  },
  "peerDependencies": {
    "@cnstra/core": "^3.2.1",
    "@cnstra/jobs": "^0.1.0",
    "@cnstra/persist": "^0.2.7",
    "@cnstra/persist-dto": "^0.2.4"
  },
  "devDependencies": {
    "@cnstra/core": "^3.2.1",
    "@cnstra/jobs": "^0.1.0",
    "@cnstra/jobs-postgres": "^0.1.0",
    "@cnstra/persist": "^0.2.7",
    "@cnstra/persist-dto": "^0.2.4",
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.12",
    "@types/node": "^24.12.2",
    "jest": "29.7.0",
    "pg": "^8.11.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
