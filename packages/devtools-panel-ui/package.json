{
  "name": "@cnstra/devtools-panel-ui",
  "version": "3.5.1",
  "description": "CNStra DevTools UI \u2014 browser panel for debugging neuron graphs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/devtools-panel-ui"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./embed": {
      "types": "./dist/lib/types/embedDeclarations.d.ts",
      "import": "./dist/lib/cnstra-devtools-panel.mjs",
      "default": "./dist/lib/cnstra-devtools-panel.mjs"
    },
    "./embed.css": "./dist/lib/cnstra-devtools-panel.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate",
    "dev": "vite",
    "build": "vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:bigdata": "playwright test --config playwright.bigdata.config.ts",
    "e2e:headed": "playwright test --headed --project=chromium",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@cnstra/core": "^3.2.2",
    "@cnstra/devtools-dto": "^3.2.1",
    "@cnstra/sync": "^0.1.1",
    "@cnstra/oimdb": "^0.1.1",
    "@cnstra/exodra": "^0.1.1",
    "@cnstra/persist-dto": "^0.2.4"
  },
  "peerDependencies": {
    "@cnstra/core": "^3.2.2",
    "@cnstra/devtools-dto": "^3.2.1",
    "@cnstra/exodra": "^0.1.1",
    "@cnstra/oimdb": "^0.1.1",
    "@cnstra/persist-dto": "^0.2.5",
    "@cnstra/sync": "^0.1.1",
    "@cnstra/types": "^0.2.1",
    "@exodra/context": "^0.3.0",
    "@exodra/core": "^0.4.0",
    "@exodra/dom": "^0.4.0",
    "@exodra/jsx": "^0.4.0",
    "@exodra/list-reconcile": "^0.3.0",
    "@oimdb/browser": "^1.3.0",
    "@oimdb/core": "^4.13.0",
    "@oimdb/exodra": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.1.2",
    "typescript": "5.8.3",
    "vite": "^6.0.0",
    "ws": "8.18.0",
    "@swc/core": "^1.15.0",
    "swc-plugin-exodra": "^0.3.0",
    "@cnstra/devtools": "^3.1.1",
    "@cnstra/devtools-server": "^3.5.0",
    "@cnstra/devtools-server-repository-in-memory": "^3.0.2",
    "@cnstra/persist": "^0.2.8",
    "@cnstra/mcp": "^2.1.1",
    "@exodra/core": "^0.4.0",
    "@exodra/dom": "^0.4.0",
    "@exodra/jsx": "^0.4.0",
    "@oimdb/core": "^4.13.0",
    "@oimdb/exodra": "^2.0.2",
    "@exodra/list-reconcile": "^0.3.0",
    "@oimdb/browser": "^1.3.0"
  }
}
