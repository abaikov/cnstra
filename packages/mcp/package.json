{
  "name": "@cnstra/mcp",
  "version": "2.1.1",
  "description": "MCP server for CNStra — gives Claude and Cursor instant understanding of your neuron graph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "cnstra",
    "mcp",
    "ai",
    "claude",
    "cursor"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "cnstra-mcp": "./dist/init.js"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate && npm run build",
    "postinstall": "node -e \"console.log('\\n  CNStra MCP installed. Run: npx @cnstra/mcp init\\n')\""
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cnstra/types": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependencies": {
    "@cnstra/core": "^3.2.2",
    "@cnstra/persist": "^0.2.8"
  },
  "devDependencies": {
    "@cnstra/core": "^3.2.2",
    "@cnstra/persist": "^0.2.8",
    "@types/node": "22.7.4",
    "tsup": "8.5.1",
    "typescript": "5.8.3"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
