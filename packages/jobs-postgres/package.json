{
  "name": "@cnstra/jobs-postgres",
  "version": "0.1.0",
  "description": "Postgres repository for @cnstra/jobs: live jobs, history, journal, schedules and type liveness in one database, with LISTEN/NOTIFY wakeups.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/jobs-postgres"
  },
  "keywords": [
    "cnstra",
    "jobs",
    "queue",
    "postgres"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate",
    "build": "tsup",
    "pretest": "prisma generate --schema src/tests/prisma/schema.prisma",
    "test": "jest",
    "test:types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@types/pg": "^8.11.0"
  },
  "peerDependencies": {
    "@cnstra/jobs": "^0.1.0",
    "pg": ">=8",
    "postgres": ">=3.4"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cnstra/jobs": "^0.1.0",
    "@jest/globals": "29.7.0",
    "@mikro-orm/core": "^6.4.5",
    "@mikro-orm/postgresql": "^6.4.5",
    "@prisma/client": "^6.2.1",
    "@types/jest": "29.5.12",
    "@types/node": "^24.12.2",
    "drizzle-orm": "^0.38.4",
    "jest": "29.7.0",
    "knex": "^3.1.0",
    "kysely": "^0.27.6",
    "pg": "^8.11.0",
    "postgres": "^3.4.5",
    "prisma": "^6.2.1",
    "sequelize": "^6.37.5",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typeorm": "^0.3.20",
    "typescript": "5.7.2",
    "@cnstra/postgres-schema": "0.1.0"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
