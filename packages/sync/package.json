{
  "name": "@cnstra/sync",
  "version": "0.1.0",
  "description": "Homeostat core for keeping local data equal to its source, independent of the state manager: receptors, the regulator that decides when a query fires, waits or settles, the correction neuron, refetch and firing policies, refractory backoff.",
  "repository": { "type": "git", "url": "git+https://github.com/abaikov/cnstra.git", "directory": "packages/sync" },
  "keywords": ["cnstra", "sync", "homeostat", "refetch", "stale-while-revalidate"],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" } },
  "sideEffects": false,
  "files": ["dist"],
  "dependencies": { "@cnstra/types": "^0.2.1" },
  "peerDependencies": { "@cnstra/core": "^3.2.1" },
  "scripts": { "prepublishOnly": "node ../../scripts/check-drift.mjs --gate", "build": "tsup", "test:types": "tsc --noEmit", "clean": "rm -rf dist", "test": "jest" },
  "devDependencies": { "@cnstra/core": "^3.2.1", "@types/jest": "29.5.12", "jest": "29.7.0", "ts-jest": "29.1.2", "tsup": "8.5.1", "typescript": "5.7.2" },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
