{
  "name": "@cnstra/oimdb",
  "version": "0.1.1",
  "description": "OIMDB binding of the CNStra homeostat: queries as OIMDB computeds over the @cnstra/sync regulator, corrections in an OIMDB collection.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/oimdb"
  },
  "keywords": [
    "cnstra",
    "oimdb",
    "sync",
    "homeostat",
    "refetch"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate",
    "build": "tsup",
    "test:types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "peerDependencies": {
    "@cnstra/sync": "^0.1.1",
    "@oimdb/core": "^4.13.0",
    "@oimdb/react": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@oimdb/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cnstra/core": "^3.2.2",
    "@cnstra/sync": "^0.1.1",
    "@oimdb/core": "^4.13.0",
    "@oimdb/react": "^4.0.0",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "29.5.12",
    "@types/react": "^18.3.24",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
