{
  "name": "@cnstra/devtools-transport-http",
  "version": "0.1.0",
  "description": "HTTP long-polling transport for CNStra DevTools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/devtools-transport-http"
  },
  "keywords": [
    "devtools",
    "cnstra",
    "transport",
    "http",
    "polling"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate && npm run test && npm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cnstra/devtools-dto": "^3.0.0"
  },
  "peerDependencies": {
    "@cnstra/devtools": "^3.0.0"
  },
  "devDependencies": {
    "@cnstra/devtools": "^3.0.0",
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "8.5.1",
    "typescript": "^5.8.3"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
