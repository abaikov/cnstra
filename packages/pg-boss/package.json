{
  "name": "@cnstra/pg-boss",
  "version": "0.4.0",
  "description": "pg-boss (Postgres) integration for CNStra: run stimulations as jobs and stream per-hop progress",
  "keywords": [
    "cnstra",
    "pg-boss",
    "postgres",
    "queue",
    "workflow",
    "orchestration"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./postgres-progress": {
      "types": "./dist/postgres-progress.d.ts",
      "import": "./dist/postgres-progress.mjs",
      "require": "./dist/postgres-progress.js"
    }
  },
  "bin": {
    "cnstra-pgboss-progress": "./dist/cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate",
    "build": "tsup",
    "test": "jest",
    "test:types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cnstra/types": "^0.2.0",
    "@cnstra/broker": "^0.2.0"
  },
  "peerDependencies": {
    "@cnstra/core": "^3.0.0",
    "@cnstra/persist": "^0.2.0",
    "@cnstra/persist-dto": "^0.2.0",
    "pg-boss": ">=9",
    "pg": ">=8"
  },
  "devDependencies": {
    "@cnstra/core": "^3.0.0",
    "@cnstra/persist": "^0.2.0",
    "@cnstra/persist-dto": "^0.2.0",
    "@types/jest": "29.5.12",
    "@types/pg": "^8.11.0",
    "jest": "29.7.0",
    "pg": "^8.11.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.7.2",
    "@cnstra/broker": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "pg-boss": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "postgres-progress": [
        "./dist/postgres-progress.d.ts"
      ]
    }
  }
}
