{
  "name": "@cnstra/jobs",
  "version": "0.1.0",
  "description": "Job queue core for CNStra: job types, retry strategies, key modes, rate limits, schedules, worker runtime, middleware and events over a pluggable repository (Postgres, Mongo, Redis or your own).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/jobs"
  },
  "keywords": [
    "cnstra",
    "jobs",
    "queue",
    "worker",
    "retry",
    "rate-limit",
    "cron"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate",
    "build": "tsup",
    "test": "jest",
    "test:types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cron-parser": "^4.9.0"
  },
  "peerDependencies": {
    "@jest/globals": "^29.0.0"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.12",
    "@types/node": "^24.12.2",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
