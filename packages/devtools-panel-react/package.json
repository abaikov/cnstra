{
  "name": "@cnstra/devtools-panel-react",
  "version": "0.1.0",
  "description": "React component that embeds the CNStra DevTools panel into an existing admin.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/devtools-panel-react"
  },
  "keywords": [
    "react",
    "cnstra",
    "devtools",
    "admin",
    "dashboard",
    "workflow",
    "orchestration"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "jest",
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate && npm run build"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@cnstra/core": "^3.2.2",
    "@cnstra/devtools-dto": "^3.2.1",
    "@cnstra/devtools-panel-ui": "^3.5.1",
    "@cnstra/exodra": "^0.1.1",
    "@cnstra/oimdb": "^0.1.1",
    "@cnstra/persist-dto": "^0.2.4",
    "@cnstra/sync": "^0.1.1",
    "@cnstra/types": "^0.2.1",
    "@exodra/context": "^0.3.0",
    "@exodra/core": "^0.4.0",
    "@exodra/dom": "^0.4.0",
    "@exodra/jsx": "^0.4.0",
    "@exodra/list-reconcile": "^0.3.0",
    "@oimdb/browser": "^1.3.0",
    "@oimdb/core": "^4.13.0",
    "@oimdb/exodra": "^2.0.2",
    "react": ">=18"
  },
  "devDependencies": {
    "@cnstra/devtools-panel-ui": "^3.5.1",
    "@types/jest": "29.5.12",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.8.3"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
