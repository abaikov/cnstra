{
  "name": "@cnstra/examples",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable CNStra examples — resumable execution, resume/retry, and queue integrations (pg-boss).",
  "type": "commonjs",
  "scripts": {
    "demo:admin": "tsx src/admin/server.ts",
    "demo:admin:pgboss": "ADMIN_QUEUE=pgboss tsx src/admin/demo.ts",
    "demo:admin:bull": "ADMIN_QUEUE=bull tsx src/admin/demo.ts",
    "demo:panel:bull": "ADMIN_QUEUE=bull tsx src/admin/panel-demo.ts",
    "demo:panel:pgboss": "ADMIN_QUEUE=pgboss tsx src/admin/panel-demo.ts",
    "demo:resume": "tsx src/resume-inprocess.ts",
    "demo:pgboss": "tsx src/pgboss-resume.ts",
    "demo:bull": "tsx src/bull-resume.ts",
    "pg:up": "docker compose up -d postgres",
    "pg:down": "docker compose down -v",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down -v",
    "test:types": "tsc --noEmit",
    "demo:pgboss:redis": "tsx src/pgboss-redis-resume.ts",
    "demo:bull:redis": "tsx src/bull-redis-resume.ts",
    "demo:pgboss:noprogress": "tsx src/pgboss-noprogress-resume.ts",
    "demo:admin:pg-store": "ADMIN_STORE=postgres tsx src/admin/server.ts",
    "demo:bull:otel": "tsx src/bull-otel.ts"
  },
  "dependencies": {
    "@cnstra/bullmq": "^0.4.1",
    "@cnstra/core": "^3.2.2",
    "@cnstra/factory": "^0.2.2",
    "@cnstra/persist": "^0.2.8",
    "@cnstra/persist-dto": "^0.2.0",
    "@cnstra/persist-otel": "^0.1.1",
    "@cnstra/persist-postgres": "^0.5.1",
    "@cnstra/pg-boss": "^0.6.1",
    "@cnstra/progress-redis": "^0.2.2"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@types/node": "^20.0.0",
    "bullmq": ">=4",
    "pg-boss": ">=9",
    "tsx": "^4.7.0",
    "typescript": "5.7.2"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT"
}
