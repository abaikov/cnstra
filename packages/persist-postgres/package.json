{
  "name": "@cnstra/persist-postgres",
  "version": "0.1.0",
  "description": "Postgres relational store for CNStra durable execution (ICNSStimulationRepository: run/attempt/task) — owns its schema + migrations",
  "keywords": ["cnstra", "postgres", "durable", "run", "attempt", "task", "persist"],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" } },
  "bin": { "cnstra-persist-postgres": "./dist/cli.js" },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@cnstra/persist": "^0.1.0",
    "@cnstra/persist-dto": "^0.1.0",
    "pg": ">=8"
  },
  "peerDependenciesMeta": { "pg": { "optional": true } },
  "devDependencies": {
    "@cnstra/persist": "^0.1.0",
    "@cnstra/persist-dto": "^0.1.0",
    "@types/jest": "29.5.12",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "jest": "29.7.0",
    "pg": "^8.11.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": { "access": "public" }
}
