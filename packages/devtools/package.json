{
  "name": "@cnstra/devtools",
  "version": "2.0.0",
  "description": "Developer tools for CNStra",
  "keywords": [
    "devtools",
    "cnstra"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run test && npm run build",
    "test": "jest -c jest.config.cjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cnstra/devtools-dto": "^2.0.0",
    "@cnstra/types": "^0.1.0"
  },
  "peerDependencies": {
    "@cnstra/core": "^2.1.0",
    "@cnstra/persist": "^0.1.0"
  },
  "devDependencies": {
    "@cnstra/core": "^2.1.0",
    "@cnstra/persist": "^0.1.0",
    "@types/node": "22.7.4",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.8.3"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
