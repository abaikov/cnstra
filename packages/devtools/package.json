{
  "name": "@cnstra/devtools",
  "version": "3.1.1",
  "description": "Developer tools for CNStra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/devtools"
  },
  "keywords": [
    "devtools",
    "cnstra"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate && npm run test && npm run build",
    "test": "jest -c jest.config.cjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cnstra/devtools-dto": "^3.2.1",
    "@cnstra/types": "^0.2.0"
  },
  "peerDependencies": {
    "@cnstra/core": "^3.2.2",
    "@cnstra/persist": "^0.2.8"
  },
  "devDependencies": {
    "@cnstra/core": "^3.2.2",
    "@cnstra/persist": "^0.2.8",
    "@types/node": "22.7.4",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.8.3"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
