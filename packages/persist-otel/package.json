{
  "name": "@cnstra/persist-otel",
  "version": "0.1.0",
  "description": "OpenTelemetry sink for CNStra resumable execution: an ICNSStimulationWriter that turns attempts and tasks into spans, plus queue/activation metrics from the CNS listeners",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git",
    "directory": "packages/persist-otel"
  },
  "keywords": [
    "cnstra",
    "opentelemetry",
    "otel",
    "tracing",
    "metrics",
    "observability"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-drift.mjs --gate",
    "build": "tsup",
    "test": "node --expose-gc ../../node_modules/.bin/jest",
    "test:types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@cnstra/persist": "^0.2.0",
    "@cnstra/persist-dto": "^0.2.0",
    "@cnstra/types": "^0.2.0",
    "@opentelemetry/api": ">=1.9"
  },
  "devDependencies": {
    "@cnstra/persist": "^0.2.0",
    "@cnstra/persist-dto": "^0.2.0",
    "@cnstra/types": "^0.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
