{
    "name": "@cnstra/devtools-server",
    "version": "3.5.1",
    "description": "CNStra DevTools server (WebSocket only for now)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abaikov/cnstra.git",
        "directory": "packages/devtools-server"
    },
    "keywords": [
        "cnstra",
        "devtools",
        "server",
        "websocket"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "bin": {
        "cnstra-devtools": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsup && tsc --emitDeclarationOnly",
        "build:types": "tsc --emitDeclarationOnly",
        "start": "node dist/index.js",
        "prepublishOnly": "node ../../scripts/check-drift.mjs --gate && npm run test && npm run build",
        "test": "jest"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@cnstra/devtools-dto": "^3.2.1",
        "@cnstra/devtools-server-repository-in-memory": "^3.0.2",
        "@cnstra/persist-dto": "^0.2.4",
        "@cnstra/types": "^0.2.0",
        "ws": "^8.18.0",
        "@cnstra/sync": "^0.1.1"
    },
    "peerDependencies": {
        "@cnstra/core": "^3.2.2",
        "@cnstra/devtools": "^3.1.1",
        "@cnstra/devtools-panel-ui": "^3.5.1",
        "@cnstra/persist": "^0.2.8"
    },
    "devDependencies": {
        "@cnstra/broker": "^0.2.3",
        "@cnstra/core": "^3.2.2",
        "@cnstra/devtools": "^3.1.1",
        "@cnstra/devtools-panel-ui": "^3.5.1",
        "@cnstra/persist": "^0.2.8",
        "@types/node": "^22.7.4",
        "@types/ws": "^8.5.10",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "tsup": "8.5.1",
        "typescript": "^5.8.3"
    },
    "peerDependenciesMeta": {
        "@cnstra/devtools-panel-ui": {
            "optional": true
        },
        "@cnstra/devtools": {
            "optional": true
        }
    },
    "author": "Andrei Baikov <abaikov23@gmail.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    }
}
