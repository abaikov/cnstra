{
  "name": "@cnstra/devtools-server",
  "version": "1.1.1",
  "description": "CNStra DevTools server (WebSocket only for now)",
  "keywords": [
    "cnstra",
    "devtools",
    "server",
    "websocket"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "cnstra-devtools": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:types": "tsc --emitDeclarationOnly",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run test && npm run build",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cnstra/devtools-dto": "^1.0.0",
    "@cnstra/devtools-server-repository-in-memory": "^1.1.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@cnstra/core": "^2.1.0",
    "@cnstra/devtools": "^1.0.1",
    "@cnstra/devtools-panel-ui": "^1.0.0",
    "@cnstra/devtools-transport-ws": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@cnstra/devtools-panel-ui": {
      "optional": true
    },
    "@cnstra/devtools": {
      "optional": true
    },
    "@cnstra/devtools-transport-ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsup": "8.5.1",
    "typescript": "^5.8.3"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
