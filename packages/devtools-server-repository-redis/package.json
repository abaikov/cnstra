{
  "name": "@cnstra/devtools-server-repository-redis",
  "version": "0.1.0",
  "description": "Redis repository for CNStra DevTools server (durable stimulations & hops)",
  "keywords": ["cnstra", "devtools", "repository", "redis", "ioredis"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "files": ["dist"],
  "dependencies": {
    "@cnstra/devtools-dto": "^1.0.0"
  },
  "peerDependencies": {
    "@cnstra/devtools-server": "^1.0.1",
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "ioredis": { "optional": true }
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
