{
  "name": "cnstra",
  "version": "1.0.0",
  "description": "Monorepo for CNStra packages",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build --workspace=@cnstra/pg-boss && npm run build --workspace=@cnstra/mcp && npm run build:devtools && npm run build:devtools-server && npm run build --workspace=@cnstra/react && npm run build --workspace=cnstra-docs",
    "build:core": "npm run build --workspace=@cnstra/core",
    "build:pg-boss": "npm run build --workspace=@cnstra/pg-boss",
    "build:devtools": "npm run build --workspace=@cnstra/devtools-dto && npm run build --workspace=@cnstra/devtools && npm run build --workspace=@cnstra/devtools-transport-ws && npm run build --workspace=@cnstra/devtools-panel-ui",
    "build:devtools-server": "npm run build --workspace=@cnstra/devtools-dto && npm run build --workspace=@cnstra/devtools-server && npm run build --workspace=@cnstra/devtools-server-repository-in-memory && npm run build --workspace=@cnstra/devtools-server-repository-postgres && npm run build --workspace=@cnstra/devtools-server-repository-redis",
    "build:devtools-panel-ui": "npm run build --workspace=@cnstra/devtools-dto && npm run build --workspace=@cnstra/devtools-panel-ui",
    "build:example": "npm run build --workspace=@cnstra/example-app",
    "dev": "npm run dev --workspaces",
    "dev:docs": "npm run start --workspace=cnstra-docs",
    "dev:core": "npm run build --workspace=@cnstra/core && npm run examples --workspace=@cnstra/core",
    "dev:devtools-panel-ui": "npm run dev --workspace=@cnstra/devtools-panel-ui",
    "dev:devtools-electron": "npm run dev --workspace=@cnstra/devtools-electron",
    "dev:example": "npm run dev --workspace=@cnstra/example-app",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node node_modules/eslint/bin/eslint.js . --fix",
    "test": "npm run test --workspaces --if-present",
    "test:types": "npm run test:types --workspaces --if-present",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "demo": "npm run build:example && npm run start:all --workspace=@cnstra/example-app",
    "dev:electron": "npm run dev --workspace=@cnstra/devtools-panel-ui & npm run dev --workspace=@cnstra/devtools-electron",
    "start:electron": "npm run start --workspace=@cnstra/devtools-electron",
    "example:start": "npm run start --workspace=@cnstra/example-app",
    "example:start:attach-electron": "npm run start:attach-electron --workspace=@cnstra/example-app",
    "release:electron": "./scripts/release-devtools-electron.sh",
    "publish:all": "node scripts/publish-workspaces.mjs",
    "publish:bumped": "node scripts/publish-workspaces.mjs --bumped",
    "publish:core": "node scripts/publish-workspaces.mjs --workspace=@cnstra/core",
    "publish:react": "node scripts/publish-workspaces.mjs --workspace=@cnstra/react",
    "docs:llms": "node scripts/generate-llms-full.mjs",
    "version:all": "npm version patch --workspaces",
    "demo:durable": "npm run demo:durable --workspace=@cnstra/examples",
    "demo:admin": "npm run demo:admin --workspace=@cnstra/examples",
    "demo:admin:pgboss": "npm run demo:admin:pgboss --workspace=@cnstra/examples",
    "demo:admin:bull": "npm run demo:admin:bull --workspace=@cnstra/examples",
    "demo:panel:bull": "npm run demo:panel:bull --workspace=@cnstra/examples",
    "demo:panel:pgboss": "npm run demo:panel:pgboss --workspace=@cnstra/examples",
    "demo:pgboss": "npm run demo:pgboss --workspace=@cnstra/examples",
    "demo:bull": "npm run demo:bull --workspace=@cnstra/examples",
    "demo:pg:up": "npm run pg:up --workspace=@cnstra/examples",
    "demo:pg:down": "npm run pg:down --workspace=@cnstra/examples",
    "demo:redis:up": "npm run redis:up --workspace=@cnstra/examples",
    "demo:redis:down": "npm run redis:down --workspace=@cnstra/examples",
    "demo:pgboss:redis": "npm run demo:pgboss:redis --workspace=@cnstra/examples",
    "demo:bull:redis": "npm run demo:bull:redis --workspace=@cnstra/examples",
    "demo:pgboss:noprogress": "npm run demo:pgboss:noprogress --workspace=@cnstra/examples",
    "demo:admin:pg-store": "npm run demo:admin:pg-store --workspace=@cnstra/examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/cnstra.git"
  },
  "bugs": {
    "url": "https://github.com/abaikov/cnstra/issues"
  },
  "homepage": "https://github.com/abaikov/cnstra#readme",
  "author": "Andrei Baikov <abaikov23@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.12",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsd": "^0.33.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "uuid": "14.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
